# Dependencies
node_modules

# Secrets - never commit these
.env
.env.local
.env.*.local

# Build output
dist
build

# CI workflows: excluded because pushing them needs the `workflow` scope on the
# token. See the note in the commit -- revisit if that scope is granted.
.github/workflows/

# Supabase CLI local cache
supabase/.temp/

# Full data dump: contains personal data (auth_identities, platform_users,
# profiles, trips, reservations, budget_preferences, audit_log, the owner's
# email). Useful as a LOCAL backup; must not be committed.
# For reference data in the repo, use supabase/reference-data.sql instead.
supabase/seed.sql
